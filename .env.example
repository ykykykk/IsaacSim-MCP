# Reference template. Export these values in the server process environment;
# isaac_mcp.server does not load .env files automatically.

# MCP client transport. stdio remains the default for local Codex and Claude Desktop clients.
ISAAC_MCP_TRANSPORT=stdio
ISAAC_MCP_HTTP_HOST=127.0.0.1
ISAAC_MCP_HTTP_PORT=8000

# Public names and domain filtering are independent.
ISAAC_MCP_TOOL_PROFILE=legacy
ISAAC_MCP_TOOL_DOMAINS=core,scene,physics,mpm
# ISAAC_MCP_CONFIG=C:/path/to/config.local.json
# ISAACSIM_ROOT=C:/path/to/isaac-sim-6.2.0

# Comma-separated exact Host header values allowed by Streamable HTTP.
# localhost, 127.0.0.1, and IPv6 loopback are always allowed, with optional ports.
# Add the complete Funnel hostname; suffix wildcards such as *.ts.net are not supported.
# MCP_ALLOWED_HOSTS=your-device.your-tailnet.ts.net

# Isaac Sim Extension runtime socket. This is separate from the HTTP MCP endpoint.
ISAAC_MCP_HOST=127.0.0.1
ISAAC_MCP_PORT=8766

# Optional shared state file used by run_isaac_sim_supervised.ps1 and get_runtime_status.
# The default is %LOCALAPPDATA%\IsaacSim-MCP\6.2\runtime-8766.json on Windows.
# ISAAC_MCP_RUNTIME_STATE_FILE=C:\Users\you\AppData\Local\IsaacSim-MCP\6.2\runtime-8766.json
# ISAAC_MCP_RUNTIME_PROBE_TIMEOUT_SECONDS=1
